---
const onHome = Astro.url.pathname === '/';
const joinHref = onHome ? '#join' : '/#join';
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="brand">
      <a class="brand__name" href="/">Revive Healthcare <span class="brand__break">Providers</span></a>
      <!-- A flat line under the name that turns into a heartbeat just past its end. -->
      <span class="brand__rule" aria-hidden="true">
        <span class="brand__line"></span>
        <svg class="brand__beat" viewBox="0 22 100 88" focusable="false">
          <path d="M0 66H10L19 47L29 85L40 27L50 105L60 56L70 72L78 66H100" vector-effect="non-scaling-stroke"></path>
        </svg>
      </span>
      <p class="brand__tagline">Reimagining Medicine. <span class="brand__break">Reviving Care.</span></p>
    </div>
    <a class="btn btn-primary site-header__cta" href={joinHref}>
      <!-- One wrapping span: inline-flex would drop the spaces between bare text runs. -->
      <span>Join <span class="desktop-only">the </span>waitlist</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    padding-block: 16px;
  }

  .brand {
    /* The heartbeat keeps the trace's 100:88 shape. */
    --beat-height: 24px;
    --beat-width: calc(var(--beat-height) * 100 / 88);

    display: inline-flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Room at the end of the text, so the heartbeat sits just after it. */
  .brand__name,
  .brand__tagline {
    padding-right: var(--beat-width);
  }

  .brand__name {
    /* Taller hit area (44px or more) without changing the layout. */
    margin-block: -10px;
    padding-block: 10px;
    font-family: var(--font-display);
    font-size: var(--fs-3);
    line-height: 1.05;
    color: var(--ink);
    text-decoration: none;
  }

  .brand__name:hover {
    color: var(--ink);
  }

  .brand__tagline {
    margin-top: 10px;
    font-size: var(--fs-1);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .brand__rule {
    display: flex;
    align-items: center;
    height: 2px;
    margin-top: 8px;
  }

  .brand__line {
    flex: 1;
    height: 2px;
    border-radius: 1px;
    background: var(--pulse-red);
  }

  .brand__beat {
    flex: none;
    width: var(--beat-width);
    height: var(--beat-height);
    overflow: visible;
  }

  .brand__beat path {
    fill: none;
    stroke: var(--pulse-red);
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .site-header__cta {
    flex: none;
    padding: 0 16px;
    font-size: var(--fs-2);
    white-space: nowrap;
  }

  .desktop-only {
    display: none;
  }

  /* Too narrow for one-line name and tagline beside the button: break each in two
     ("Revive Healthcare / Providers", "Reimagining Medicine. / Reviving Care."). */
  @media (max-width: 499px) {
    .brand__break {
      display: block;
    }
  }

  /* A little more room for the name at 360px. */
  @media (max-width: 379px) {
    .site-header__cta {
      padding: 0 14px;
    }
  }

  @media (min-width: 720px) {
    .site-header {
      border-bottom: 0;
    }

    .site-header__inner {
      gap: 16px;
      padding-block: 28px;
    }

    .brand {
      --beat-height: 32px;
    }

    .brand__name {
      font-size: var(--fs-4);
      line-height: 1;
      letter-spacing: 0.01em;
    }

    .brand__tagline {
      margin-top: 12px;
      font-size: var(--fs-2);
    }

    .brand__rule {
      margin-top: 10px;
    }

    .site-header__cta {
      padding: 0 22px;
    }

    .desktop-only {
      display: inline;
    }
  }
</style>
