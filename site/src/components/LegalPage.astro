---
interface Props {
  title: string;
  /** ISO date, e.g. "2026-11-10". */
  effectiveDate: string;
}

const { title, effectiveDate } = Astro.props;
const effectiveLabel = new Date(`${effectiveDate}T12:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class="container legal">
  <h1>{title}</h1>
  <p class="legal__effective">Effective Date: <time datetime={effectiveDate}>{effectiveLabel}</time></p>
  <slot />
</article>

<style>
  .legal {
    max-width: calc(var(--max-w-join) + 2 * var(--gutter));
    padding-top: 44px;
    padding-bottom: 72px;
  }

  h1 {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-size: var(--fs-5);
    line-height: 1.05;
  }

  .legal__effective {
    margin-bottom: 32px;
    color: var(--ink-subtle);
  }

  .legal :global(h2) {
    margin: 40px 0 12px;
    font-family: var(--font-display);
    font-size: var(--fs-4);
    line-height: 1.2;
  }

  .legal :global(p),
  .legal :global(li) {
    font-size: var(--fs-2);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .legal :global(ul) {
    margin: 0;
    padding-left: 22px;
  }

  .legal :global(li + li) {
    margin-top: 8px;
  }

  .legal :global(li::marker) {
    color: var(--ink-subtle);
  }

  .legal :global(:is(p, ul) + :is(p, ul)) {
    margin-top: 12px;
  }

  .legal :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  @media (min-width: 720px) {
    .legal {
      padding-top: 64px;
      padding-bottom: 104px;
    }

    h1 {
      font-size: var(--fs-6);
    }
  }
</style>
