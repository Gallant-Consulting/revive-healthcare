# Where the waitlist form POSTs its JSON. Required for production builds.
# Leave empty in local dev to simulate a successful submission.
PUBLIC_FORM_ENDPOINT=

# Where the unsubscribe page POSTs { id } to turn off a sign-up's emails.
PUBLIC_UNSUBSCRIBE_ENDPOINT=

# Optional. A cookieless analytics script URL (e.g. Plausible, Fathom). Leave empty for none.
PUBLIC_ANALYTICS_SRC=
